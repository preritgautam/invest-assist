generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Remove directUrl - not needed for Prisma Accelerate
}

model User {
  id        String   @id
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scenarios  Scenario[]
  documents  Document[]
  
  @@map("users")
}

model Scenario {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String   @map("owner_id")
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  payload     Json     @default("{}") @db.JsonB
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([ownerId], name: "idx_scenarios_owner")
  @@map("scenarios")
}

model Document {
  id                Int       @id @default(autoincrement())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  processId         String    @unique @map("process_id")
  documentId        String?   @map("document_id")
  filename          String
  documentType      String?   @map("document_type")
  fileSize          BigInt?   @map("file_size")
  uploadStatus      String    @default("pending") @map("upload_status")
  extractionStatus  String    @default("pending") @map("extraction_status")
  extractionResult  Json?     @map("extraction_result") @db.JsonB
  errorMessage      String?   @map("error_message")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@unique([userId, processId])
  @@index([userId], name: "idx_documents_user_id")
  @@index([processId], name: "idx_documents_process_id")
  @@index([uploadStatus], name: "idx_documents_upload_status")
  @@index([extractionStatus], name: "idx_documents_extraction_status")
  @@index([createdAt], name: "idx_documents_created_at")
  @@index([deletedAt], name: "idx_documents_deleted_at")
  @@map("documents")
}

